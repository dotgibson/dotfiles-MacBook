# Theme — Nord (Arctic Ice Studio), 0.90 opacity and NO blur. Keep in sync with
# sketchybar/themes/nord.lua: bg #2E3440, fg #D8DEE9, accent #88C0D0. No `theme =`
# line: the bundled Nord theme would fight the explicit palette below. This is
# subtle translucency, not glass: blur stays off and the palette remains Nord.
background = 2E3440
background-opacity = 0.90
foreground = D8DEE9
cursor-color = 88C0D0
selection-background = 4C566A
selection-foreground = ECEFF4

palette = 0=#3B4252
palette = 1=#BF616A
palette = 2=#A3BE8C
palette = 3=#EBCB8B
palette = 4=#81A1C1
palette = 5=#B48EAD
palette = 6=#88C0D0
palette = 7=#E5E9F0
palette = 8=#4C566A
palette = 9=#BF616A
palette = 10=#A3BE8C
palette = 11=#EBCB8B
palette = 12=#81A1C1
palette = 13=#B48EAD
palette = 14=#8FBCBB
palette = 15=#ECEFF4

macos-window-buttons = hidden
macos-titlebar-style = hidden

# Font
font-family = 'CaskaydiaCove Nerd Font'
font-size = 13
font-thicken = true
# Programming ligatures. Ghostty expects OpenType feature TAGS (unquoted, one per
# line, repeatable) — not `"+ligatures"`, which is not a real tag and was silently
# ignored, so ligatures fell back to default behavior. `calt` (contextual
# alternates) drives CaskaydiaCove's -> => != etc.; `liga` enables standard ligatures.
font-feature = calt
font-feature = liga

# Cursor — bar caret (softer than block). Revert with `cursor-style = block`.
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# Ambient shader — animated starfield behind the terminal (opt-in eye-candy).
# COST: continuous GPU draw → measurable battery use on a laptop. To turn it off,
# comment the two lines below and reload (cmd+shift+, ). The shader lives in the
# repo at ghostty/shaders/space.glsl, linked into ~/.config/ghostty/shaders.
# custom-shader = ~/.config/ghostty/shaders/space.glsl
# custom-shader-animation = false

# Window
window-save-state = always
confirm-close-surface = false
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
# balance=true splits the non-divisible grid leftover evenly, so left/right
# (and top/bottom) stay even. x == y == 12 → equal inset on all four sides.
# Dim inactive splits so focus lands on the active pane.
unfocused-split-opacity = 0.85
# Keyboard / macOS
# macOS emite glifos Unicode (Ω ≈ …) sobre Option en vez de Alt — lo que rompe todo binding
# Alt posterior: zsh Alt+Z (zoxide jump), tmux Alt+H/L (windows) y Alt+arrows (panes).
# `left` = SOLO el Option izquierdo actúa como Alt; el DERECHO conserva el comportamiento
# de teclado español y compone los símbolos que necesitan Option: {} [] @ € ~ etc.
# (con `true`, que convertía los DOS, esos símbolos dejaban de poder escribirse).
macos-option-as-alt = left
# Shell integration: defaults already enable cursor/title/path; this adds `sudo` so
# password prompts behave correctly. (cursor/title/path stay on — the flag merges.)
shell-integration-features = sudo

# Quick terminal + key passthrough
keybind = alt+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.2
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u

# Discoverability: command palette (fuzzy-search every action + its keybind)
keybind = cmd+shift+p=toggle_command_palette

# ⌘C llega a nvim como <M-c> (copiar selección/línea al portapapeles del sistema).
# La copia de texto del terminal queda en ⌘⇧C.
keybind = cmd+shift+c=copy_to_clipboard:plain
keybind = cmd+c=esc:c

# ⌘C llega a nvim como <M-c> (copiar selección/línea al portapapeles del sistema).
# La copia de texto del terminal queda en ⌘⇧C.
keybind = cmd+shift+c=copy_to_clipboard:plain
keybind = cmd+c=esc:c
